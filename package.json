{
  "name": "mazmi-factory-gmao",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise maintenance, assets and MRO foundation for industrial plants.",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --ip 0.0.0.0 --local --persist-to .wrangler/worker-state --show-interactive-dev-session=false",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "node scripts/smoke.mjs",
    "test:audit:http": "node scripts/independent-http.mjs",
    "test:smoke:compiled": "node scripts/independent-http.mjs --smoke-only",
    "test:visual:compiled": "node scripts/independent-http.mjs --visual-only",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.0",
    "@cloudflare/workers-types": "^5.20260826.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.3",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  },
  "type": "module"
}

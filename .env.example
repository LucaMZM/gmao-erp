# Mazmi Factory GMAO V0 does not require external API keys.
# Hosted bindings are declared in .openai/hosting.json.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local preview defaults to DEMO. Hosted deployments default to PRODUCTION.
MAZMI_APP_MODE=DEMO
# For an empty PRODUCTION database, set a unique high-entropy token as a
# private Worker secret, then remove it after initial provisioning.
# MAZMI_BOOTSTRAP_TOKEN=
